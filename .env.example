# EmailJS credentials — copy this file to .env and fill in your values.
#   Public Key:  Dashboard → Account → General → Public Key
#   Service ID:  Email Services → your service ID
#   Template ID: Email Templates → your template ID
# Your EmailJS template should reference {{name}}, {{email}}, {{message}}.
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
